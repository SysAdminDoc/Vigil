{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "0.2.3",
  "version_name": "0.2.3",
  "description": "__MSG_extensionDescription__",
  "key": "",
  "minimum_chrome_version": "120",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16":  "icons/vigil_16.png",
    "32":  "icons/vigil_32.png",
    "48":  "icons/vigil_48.png",
    "128": "icons/vigil_128.png"
  },
  "permissions": [
    "storage",
    "topSites",
    "bookmarks"
  ],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src https:"
  },
  "incognito": "split"
}
