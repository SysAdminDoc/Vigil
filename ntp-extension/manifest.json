{
  "manifest_version": 3,
  "name": "Vigil New Tab",
  "short_name": "Vigil NTP",
  "version": "0.2.0",
  "version_name": "0.2.0",
  "description": "Vigil's lean, dark new-tab page with optional local widgets. Network widgets are opt-in.",
  "key": "",
  "minimum_chrome_version": "120",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16":  "icons/vigil_16.png",
    "32":  "icons/vigil_32.png",
    "48":  "icons/vigil_48.png",
    "128": "icons/vigil_128.png"
  },
  "permissions": [
    "storage",
    "topSites",
    "bookmarks"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://www.google.com/s2/favicons; connect-src https:"
  },
  "incognito": "split"
}
