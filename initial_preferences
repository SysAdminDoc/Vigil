{
  "bookmark_bar": {
    "show_on_all_tabs": true
  },
  "browser": {
    "check_default_browser": false,
    "show_home_button": true,
    "has_seen_welcome_page": true,
    "default_browser_infobar_last_declined": "99999999999999.0"
  },
  "distribution": {
    "skip_first_run_ui": true,
    "suppress_first_run_default_browser_prompt": true,
    "import_bookmarks": false,
    "import_history": false,
    "import_search_engine": false,
    "make_chrome_default_for_user": false
  },
  "default_search_provider_data": {
    "template_url_data": {
      "keyword": "duckduckgo.com",
      "short_name": "DuckDuckGo",
      "url": "https://duckduckgo.com/?q={searchTerms}",
      "suggest_url": "https://duckduckgo.com/ac/?q={searchTerms}&type=list"
    }
  },
  "search": {
    "suggest_enabled": true
  },
  "dns_prefetching": {
    "enabled": false
  },
  "net": {
    "network_prediction_options": 2
  },
  "safebrowsing": {
    "enabled": true,
    "enhanced": false,
    "scout_reporting_enabled": false,
    "extended_reporting_enabled": false
  },
  "https_only_mode_enabled": true,
  "https_first_balanced_mode_enabled": true,
  "alternate_error_pages": {
    "enabled": false
  },
  "autofill": {
    "profile_enabled": false,
    "credit_card_enabled": false
  },
  "translate": {
    "enabled": false
  },
  "signin": {
    "allowed_on_next_startup": false
  },
  "enable_do_not_track": true,
  "privacy_sandbox": {
    "apis_enabled_v2": false,
    "m1": {
      "topics_enabled": false,
      "fledge_enabled": false,
      "ad_measurement_enabled": false,
      "consent_decision_made": true,
      "row_notice_acknowledged": true,
      "eea_notice_acknowledged": true,
      "restricted_notice_acknowledged": true
    }
  },
  "profile": {
    "default_content_setting_values": {
      "notifications": 2,
      "usb_devices": 2,
      "serial_ports": 2,
      "hid_devices": 2,
      "bluetooth_devices": 2,
      "idle_detection": 2,
      "local_fonts": 2,
      "payment_handler": 2,
      "ar": 2,
      "vr": 2,
      "automatic_downloads": 2
    },
    "password_manager_enabled": false
  },
  "download": {
    "prompt_for_download": true
  },
  "session": {
    "restore_on_startup": 1
  },
  "extensions": {
    "theme": {
      "use_system": false
    }
  },
  "webkit": {
    "webprefs": {
      "default_font_size": 16,
      "minimum_font_size": 10
    }
  }
}
