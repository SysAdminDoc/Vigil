<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Vigil Browser"
      Manufacturer="SysAdminDoc"
      Version="$(var.ProductVersion)"
      UpgradeCode="{3F7B1D1E-85E6-4F6F-8CB8-73F0AA4CBF1A}"
      Scope="perMachine">
    <SummaryInformation Description="Vigil Browser" Manufacturer="SysAdminDoc" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Vigil is already installed." />
    <MediaTemplate EmbedCab="yes" />

<?if $(var.Platform) = x64 OR $(var.Platform) = arm64 ?>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vigil" />
    </StandardDirectory>
<?else?>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Vigil" />
    </StandardDirectory>
<?endif?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Vigil" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Vigil Browser" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BuildOutput)\**" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder">
      <Shortcut
          Id="VigilStartMenuShortcut"
          Name="Vigil"
          Description="Vigil Browser"
          Target="[INSTALLFOLDER]chrome.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
          Root="HKLM"
          Key="Software\SysAdminDoc\Vigil"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <RemoveFolder Id="RemoveVigilStartMenuFolder" On="uninstall" />
    </Component>
  </Fragment>
</Wix>
