{
  "manifest_version": 3,
  "name": "Vigil Command Palette",
  "short_name": "Vigil Palette",
  "version": "0.2.1",
  "version_name": "0.2.1",
  "description": "A keyboard-first launcher for Vigil settings, tabs, bookmarks, and recent history.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "bookmarks",
    "history",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "Open the Vigil command palette"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html", "palette.js", "palette.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'"
  },
  "incognito": "split"
}
