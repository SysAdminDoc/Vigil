{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "0.2.2",
  "version_name": "0.2.2",
  "description": "__MSG_extensionDescription__",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "__MSG_openPaletteCommand__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html", "palette.js", "palette.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'"
  },
  "incognito": "split"
}
